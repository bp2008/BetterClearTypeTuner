<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- No <startup><supportedRuntime> element here on purpose: the SDK generates one per target
	     framework, so each executable declares the framework version it was actually built against. -->
	<System.Windows.Forms.ApplicationConfigurationSection>
		<add key="DpiAwareness" value="PerMonitorV2" />
		<!--<add key="EnableWindowsFormsHighDpiAutoResizing" value="false" />-->
	</System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
